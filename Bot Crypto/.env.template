# ============================================
# ANTIGRAVITY HIGH - TRIFECTA PERFECTA
# Configuración de Credenciales Seguras
# ============================================
# ⚠️ ESTE ARCHIVO NUNCA DEBE SUBIRSE A GIT
# ⚠️ RENOMBRAR A .env.production ANTES DE USAR
# ⚠️ REEMPLAZAR TODOS LOS VALORES "your_..._here"
# ============================================

# ==========================================
# MASTER ACCOUNT (Solo lectura + Transfers)
# ==========================================
MASTER_API_KEY=your_master_api_key_here
MASTER_API_SECRET=your_master_api_secret_here
MASTER_EXCHANGE=binance

# ==========================================
# MOTOR B1: SPRINT (Futures Trading)
# Perfil: Osado | Meta: $1,000,000 | Plazo: 365 días
# Apalancamiento: 10x-20x | Rendimiento: 1.9106%/día
# ==========================================
B1_API_KEY=your_b1_api_key_here
B1_API_SECRET=your_b1_api_secret_here
B1_EXCHANGE=binance
B1_SUBACCOUNT_ID=B1_SPRINT
B1_MAX_LEVERAGE=20
B1_CAPITAL_LIMIT=1000

# ==========================================
# MOTOR B2: RESILIENCE (Futures Trading)
# Perfil: Intermedio | Meta: $1,000,000 | Plazo: 730 días
# Apalancamiento: 3x-5x | Rendimiento: 0.9508%/día
# ==========================================
B2_API_KEY=your_b2_api_key_here
B2_API_SECRET=your_b2_api_secret_here
B2_EXCHANGE=binance
B2_SUBACCOUNT_ID=B2_RESILIENCE
B2_MAX_LEVERAGE=5
B2_CAPITAL_LIMIT=1000

# ==========================================
# MOTOR B3: ANCHOR (Futures Trading)
# Perfil: Conservador | Meta: $250,000 | Plazo: 730 días
# Apalancamiento: 1x-3x | Rendimiento: 0.7592%/día
# ==========================================
B3_API_KEY=your_b3_api_key_here
B3_API_SECRET=your_b3_api_secret_here
B3_EXCHANGE=binance
B3_SUBACCOUNT_ID=B3_ANCHOR
B3_MAX_LEVERAGE=3
B3_CAPITAL_LIMIT=1000

# ==========================================
# MONITOR (Solo Lectura - Dashboard/Telegram)
# ==========================================
MONITOR_API_KEY=your_monitor_api_key_here
MONITOR_API_SECRET=your_monitor_api_secret_here

# ==========================================
# SEGURIDAD DE RED
# ==========================================
VPS_STATIC_IP=xxx.xxx.xxx.xxx
ALLOWED_IPS=xxx.xxx.xxx.xxx

# ==========================================
# ALERTAS TELEGRAM
# ==========================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ==========================================
# KILL SWITCH CONFIGURATION
# Supervivencia de Capital > Todo
# ==========================================
MAX_DRAWDOWN_PERCENT=15
KILL_SWITCH_ENABLED=true
HIBERNATION_HOURS=24

# ==========================================
# SUPABASE (Logs y Base de Datos)
# ==========================================
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ==========================================
# ENTORNO
# ==========================================
NODE_ENV=production
LOG_LEVEL=info
