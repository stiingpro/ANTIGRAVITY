# ============================================
# ANTIGRAVITY — Root .gitignore
# ============================================

# Secrets & credentials (CRITICAL)
.env
.env.*
!.env.template
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
venv/
.venv/
*.egg

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
Thumbs.db
desktop.ini
.DS_Store
ehthumbs.db

# Node (if applicable)
node_modules/

# Logs
*.log
logs/

# Railway
.railway/

# Data caches (local only)
data_cache/
